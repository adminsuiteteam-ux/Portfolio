{
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "files.exclude": {
    "**/assets/*.js": true,
    "**/dist": true
  },
  "search.exclude": {
    "**/assets/*.js": true,
    "**/dist": true
  },
  "securecoder.rules.disable": [
    "@shopify/jsx-no-hardcoded-content"
  ],
  "securecoder.i18n.enabled": false,
  "problems.decorations.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  }
}
